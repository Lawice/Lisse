{
  "multipart": [
    { "when": { "up": "true" },
      "apply": { "model": "block/end_stone_brick_wall_post" }
    },

    { "when": { "AND": [
      { "north": "low", "south": "low" },
      { "OR": [ { "east": "tall|none" }, { "west": "tall|none" } ] }
    ] },
      "apply": { "model": "block/end_stone_brick_wall", "y": 180 }
    },
    { "when": { "AND": [
      { "east": "low", "west": "low" },
      { "OR": [ { "north": "tall|none" }, { "south": "tall|none" } ] }
    ] },
      "apply": { "model": "block/end_stone_brick_wall", "y": 270 }
    },
    { "when": { "AND": [
      { "north": "tall", "south": "tall" },
      { "OR": [ { "east": "low|none" }, { "west": "low|none" } ] }
    ] },
      "apply": { "model": "block/end_stone_brick_wall_tall", "y": 180 }
    },
    { "when": { "AND": [
      { "east": "tall", "west": "tall" },
      { "OR": [ { "north": "low|none" }, { "south": "low|none" } ] }
    ] },
      "apply": { "model": "block/end_stone_brick_wall_tall", "y": 270 }
    },

    { "when": { "north": "low", "south": "tall|none" },
      "apply": { "model": "block/end_stone_brick_wall_side" }
    },
    { "when": { "east": "low", "west": "tall|none" },
      "apply": { "model": "block/end_stone_brick_wall_side", "y": 90 }
    },
    { "when": { "south": "low", "north": "tall|none" },
      "apply": { "model": "block/end_stone_brick_wall_side_alt" }
    },
    { "when": { "west": "low", "east": "tall|none" },
      "apply": { "model": "block/end_stone_brick_wall_side_alt", "y": 90 }
    },

    { "when": { "north": "tall", "south": "low|none" },
      "apply": { "model": "block/end_stone_brick_wall_side_tall" }
    },
    { "when": { "east": "tall", "west": "low|none" },
      "apply": { "model": "block/end_stone_brick_wall_side_tall", "y": 90 }
    },
    { "when": { "south": "tall", "north": "low|none" },
      "apply": { "model": "block/end_stone_brick_wall_side_tall_alt" }
    },
    { "when": { "west": "tall", "east": "low|none" },
      "apply": { "model": "block/end_stone_brick_wall_side_tall_alt", "y": 90 }
    },

    { "when": { "north": "low", "south": "low", "east": "low", "west": "low" },
      "apply": { "model": "block/end_stone_brick_wall_cross" }
    },
    { "when": { "north": "tall", "south": "tall", "east": "tall", "west": "tall" },
      "apply": { "model": "block/end_stone_brick_wall_cross_tall" }
    }
  ]
}